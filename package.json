{
  "name": "arthurs-world",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:books": "npm -w apps/books run dev",
    "dev:games": "npm -w apps/games run dev",
    "dev:music": "npm -w apps/music run dev",
    "build:books": "npm -w apps/books run build",
    "build:games": "npm -w apps/games run build",
    "build:music": "npm -w apps/music run build",
    "build:all": "npm run build:books && npm run build:games && npm run build:music",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@rive-app/react-canvas": "^4.27.1",
    "framer-motion": "^12.36.0",
    "lottie-react": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
